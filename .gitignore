node_modules
dist
dist-ssr
.vite
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# TS incremental build cache
*.tsbuildinfo

# Env files
.env
.env.local
.env.*.local

# Local AI tool state / personal config
.claude

# Plugin pushes — Superpowers (brainstorm/plans/specs) + the Claw
# "design-system/" scaffold. Generated by external tooling, not part of
# the app. The leading slash on /design-system/ anchors it to the repo
# root so the real doc at src/styles/design-system.md is NOT ignored.
.superpowers/
/design-system/
/docs/superpowers/

# Playwright MCP scratch (page-*.yml snapshots, console-*.log); these
# are generated each time playwright drives the page during dev /
# debugging and should never be committed.
.playwright-mcp/

# Ad-hoc screenshots taken at the repo root. Legitimate site assets
# (icons, posters, exported renders) live under public/ and are NOT
# ignored. This pattern only catches PNG/JPG dropped at the top level.
/*.png
/*.jpg
/*.jpeg
/*.webp

# ── Dev scratch (Playwright captures, preview/demo HTML, screenshot dumps) ──
# Never commit. Regenerated on demand during design iteration.
/scripts/capture-*.mjs
# Playwright verification / diagnostic scripts (dev-only, not site code).
/scripts/verify-*.mjs
/scripts/diag-*.mjs
/public/*-preview.html
/*-previews/
/*-shots/
/*-verify/
/ring-glitch/
/ring-assemble/
/hero-ignition/
/hero-settled/
/intro-freeze/
/antimetal-ref/
/.scratch/
# Pristine GLB backups from optimize-assets.mjs (huge — keep out of git)
public/*.original.glb
# Raw re-baked room source (~38 MB). The committed/shipped room is the
# gltf-transform output room-optimized.web.glb (~4 MB); this is the
# heavy source it's optimized FROM — keep it local, never commit/ship.
public/room-optimized.glb

# Raw photo drops — only the optimized public/photos/ output is committed.
/photos-inbox/*
!/photos-inbox/README.md

# Local asset backup (kept out of public/ so it never ships in dist)
room.original.glb.bak
.gstack/
